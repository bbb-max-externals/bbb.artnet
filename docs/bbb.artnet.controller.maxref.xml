<c74object name='bbb.artnet.controller' category='dmx,  artnet,  lighting'>

	<digest>Send DMX via Art-Net protocol</digest>
	<description>Send DMX via Art-Net protocol. </description>


	<!--METADATA-->

	<metadatalist>
		<metadata name='author'>bbb </metadata>
		<metadata name='tag'>dmx</metadata>
		<metadata name='tag'>artnet</metadata>
		<metadata name='tag'>lighting</metadata>
	</metadatalist>


	<!--ARGUMENTS-->

	<objarglist>

		<objarg name='net' optional='1' type='int'>
			<digest>Art-Net net address (0-127)</digest>
			<description>Art-Net net address (0-127). </description>
		</objarg>

		<objarg name='subnet' optional='1' type='int'>
			<digest>Art-Net subnet address (0-15)</digest>
			<description>Art-Net subnet address (0-15). </description>
		</objarg>

		<objarg name='universe' optional='1' type='int'>
			<digest>Art-Net universe address (0-15)</digest>
			<description>Art-Net universe address (0-15). </description>
		</objarg>

	</objarglist>


	<!--MESSAGES-->

	<methodlist>

		<method name='set_offset'>
			<digest>Store DMX values at offset (0-based) without sending</digest>
			<description>Store DMX values at offset (0-based) without sending. </description>
		</method>

		<method name='setchannel'>
			<digest>Set a single DMX channel (1-based index)</digest>
			<description>Set a single DMX channel (1-based index). </description>
		</method>

		<method name='set'>
			<digest>Store DMX values without sending</digest>
			<description>Store DMX values without sending. </description>
		</method>

		<method name='bang'>
			<digest>Trigger send in bang mode</digest>
			<description>Trigger send in bang mode. </description>
		</method>

		<method name='channel'>
			<digest>Set a single DMX channel (1-based index)</digest>
			<description>Set a single DMX channel (1-based index). </description>
		</method>

		<method name='list'>
			<digest>Set DMX values from a list</digest>
			<description>Set DMX values from a list. </description>
		</method>

	</methodlist>


	<!--ATTRIBUTES-->

	<attributelist>

		<attribute name='alt_broadcast_ip' get='1' set='1' type='long' size='1' >
			<digest>Use 10.x.x.x broadcast range instead of 2.x.x.x</digest>
			<description>Use 10.x.x.x broadcast range instead of 2.x.x.x. </description>
		</attribute>

		<attribute name='blackout' get='1' set='1' type='long' size='1' >
			<digest>Send all zeros (blackout)</digest>
			<description>Send all zeros (blackout). </description>
		</attribute>

		<attribute name='framerate' get='1' set='1' type='float64' size='1' >
			<digest>Framerate for forced mode (0.01 - 44)</digest>
			<description>Framerate for forced mode (0.01 - 44). </description>
		</attribute>

		<attribute name='mode' get='1' set='1' type='symbol' size='1' >
			<digest>Output mode: automatic, bang, update, change, forced</digest>
			<description>Output mode: automatic, bang, update, change, forced. </description>
		</attribute>

		<attribute name='net' get='1' set='1' type='long' size='1' >
			<digest>Art-Net net address (0-127)</digest>
			<description>Art-Net net address (0-127). </description>
		</attribute>

		<attribute name='num_channels' get='1' set='1' type='long' size='1' >
			<digest>Number of DMX channels per universe</digest>
			<description>Number of DMX channels per universe. </description>
		</attribute>

		<attribute name='num_universes' get='1' set='1' type='long' size='1' >
			<digest>Number of universes to manage</digest>
			<description>Number of universes to manage. </description>
		</attribute>

		<attribute name='osc_port' get='1' set='1' type='long' size='1' >
			<digest>OSC receive port (0 = disabled)</digest>
			<description>OSC receive port (0 = disabled). </description>
		</attribute>

		<attribute name='subnet' get='1' set='1' type='long' size='1' >
			<digest>Art-Net subnet address (0-15)</digest>
			<description>Art-Net subnet address (0-15). </description>
		</attribute>

		<attribute name='sync_universes' get='1' set='1' type='long' size='1' >
			<digest>Send all universes when any data changes</digest>
			<description>Send all universes when any data changes. </description>
		</attribute>

		<attribute name='unicast' get='1' set='1' type='long' size='1' >
			<digest>Use unicast mode</digest>
			<description>Use unicast mode. </description>
		</attribute>

		<attribute name='unicast_ip' get='1' set='1' type='symbol' size='1' >
			<digest>Destination IP for unicast mode</digest>
			<description>Destination IP for unicast mode. </description>
		</attribute>

		<attribute name='universe' get='1' set='1' type='long' size='1' >
			<digest>Art-Net universe address (0-15)</digest>
			<description>Art-Net universe address (0-15). </description>
		</attribute>

	</attributelist>


	<!--RELATED-->

	<seealsolist>
		<seealso name='bbb.artnet.node' />
	</seealsolist>


</c74object>
